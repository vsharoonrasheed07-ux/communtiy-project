# PostgreSQL connection string (Neon Postgres recommended for Vercel)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/stayinschool?sslmode=require"

# JWT / Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Secret header token used by Vercel Cron to authorize /api/cron/daily
CRON_SECRET="replace-with-a-random-cron-secret"

# App public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SMS / WhatsApp Notification Provider: "mock" | "twilio" | "msg91"
SMS_PROVIDER="mock"

# Twilio (used when SMS_PROVIDER="twilio")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM=""

# MSG91 (used when SMS_PROVIDER="msg91")
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="STAYIN"
MSG91_TEMPLATE_ID=""

# Email Digest Provider: "mock" | "resend" | "smtp"
EMAIL_PROVIDER="mock"
EMAIL_FROM="noreply@stayinschool.org"
RESEND_API_KEY=""
